NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public origin used in auth email links, e.g. https://mib-acrobatics.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: landing page background video (mp4)
NEXT_PUBLIC_HERO_VIDEO_URL=
# Server-only (never NEXT_PUBLIC_): service_role / secret key for creating and deleting users from /dashboard/users
SUPABASE_SERVICE_ROLE_KEY=

# Push notifications (Firebase Cloud Messaging). Web config + VAPID key are public; the service account is secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Whole service-account JSON (one line) or its base64. Server-only.
FIREBASE_SERVICE_ACCOUNT=
# Random string; the pg_cron job sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/reminders.
CRON_SECRET=
